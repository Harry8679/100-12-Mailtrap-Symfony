{#
    Template HTML d'email de bienvenue
    Utilisé par TemplatedEmail dans NewsletterController::index()
    Variable disponible : {{ abonne }}
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!--
        IMPORTANT pour les emails : utiliser du CSS inline, pas de fichier externe.
        Les clients email (Gmail, Outlook...) ignorent les feuilles de style externes.
    -->
    <style>
        body        { font-family: Arial, sans-serif; background: #f9fafb; margin: 0; padding: 0; }
        .container  { max-width: 560px; margin: 40px auto; background: #ffffff; border-radius: 12px; overflow: hidden; }
        .header     { background: #111827; padding: 32px; text-align: center; }
        .header h1  { color: #ffffff; font-size: 24px; margin: 0; }
        .body       { padding: 32px; }
        .body h2    { font-size: 20px; color: #111827; margin-top: 0; }
        .body p     { color: #6b7280; line-height: 1.6; font-size: 14px; }
        .btn        { display: inline-block; background: #111827; color: #ffffff; padding: 12px 24px;
                      border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: bold; margin-top: 16px; }
        .footer     { background: #f3f4f6; padding: 16px 32px; text-align: center; }
        .footer p   { color: #9ca3af; font-size: 12px; margin: 0; }
        .footer a   { color: #6b7280; }
    </style>
</head>
<body>
    <div class="container">

        <div class="header">
            <h1>📧 Mon Site</h1>
        </div>

        <div class="body">
            <h2>
                Bienvenue
                {% if abonne.prenom %}{{ abonne.prenom }}{% endif %}
                ! 🎉
            </h2>

            <p>
                Tu viens de t'inscrire à notre newsletter. Merci pour ta confiance !
            </p>

            <p>
                Tu recevras régulièrement nos actualités, astuces et nouveautés
                directement dans ta boîte email.
            </p>

            <a href="https://monsite.fr" class="btn">
                Visiter notre site →
            </a>
        </div>

        <div class="footer">
            <p>
                Tu reçois cet email car tu t'es inscrit(e) avec <strong>{{ abonne.email }}</strong>.
                <br>
                {#
                    On passe l'email encodé dans l'URL de désabonnement.
                    En production, utiliser un token sécurisé plutôt que l'email en clair.
                #}
                <a href="{{ url('app_newsletter_desabonner', { email: abonne.email }) }}">
                    Se désabonner
                </a>
            </p>
        </div>

    </div>
</body>
</html>