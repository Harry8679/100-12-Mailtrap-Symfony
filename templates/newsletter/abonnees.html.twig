{% extends 'base.html.twig' %}

{% block title %}Abonnés{% endblock %}

{% block body %}

<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Abonnés</h1>
        <p class="text-gray-400 text-sm mt-1">
            {{ abonnes|length }} abonné(s) au total
        </p>
    </div>
</div>

{% if abonnes is empty %}

    <div class="text-center py-16">
        <p class="text-gray-400">Aucun abonné pour l'instant.</p>
        <a href="{{ path('app_newsletter_index') }}" class="text-blue-500 text-sm hover:underline mt-2 inline-block">
            Voir le formulaire d'inscription
        </a>
    </div>

{% else %}

    <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-widest">Email</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-widest">Prénom</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-widest">Inscrit le</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-widest">Statut</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for abonne in abonnes %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-5 py-3 font-medium text-gray-900">{{ abonne.email }}</td>
                        <td class="px-5 py-3 text-gray-500">{{ abonne.prenom ?? '—' }}</td>
                        <td class="px-5 py-3 text-gray-400">{{ abonne.inscritLe|date('d/m/Y') }}</td>
                        <td class="px-5 py-3">
                            {% if abonne.actif %}
                                <span class="text-xs bg-green-100 text-green-700 font-semibold px-2 py-0.5 rounded-full">Actif</span>
                            {% else %}
                                <span class="text-xs bg-gray-100 text-gray-500 font-semibold px-2 py-0.5 rounded-full">Inactif</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% endif %}

{% endblock %}