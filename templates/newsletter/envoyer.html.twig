{% extends 'base.html.twig' %}

{% block title %}Envoyer une newsletter{% endblock %}

{% block body %}

<h1 class="text-3xl font-bold text-gray-900 mb-2">Envoyer une newsletter</h1>
<p class="text-gray-400 mb-8">Le message sera envoyé à tous les abonnés actifs.</p>

<form method="POST" action="{{ path('app_newsletter_envoyer') }}">

    <div class="bg-white border border-gray-200 rounded-2xl p-6 flex flex-col gap-5">

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
                Sujet de l'email
            </label>
            <input
                type="text"
                name="sujet"
                required
                placeholder="Ex : Notre actu de mars 2025"
                class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gray-500"
            >
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
                Contenu de l'email
            </label>
            <textarea
                name="contenu"
                required
                rows="8"
                placeholder="Écris ici le contenu de ta newsletter..."
                class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gray-500"
            ></textarea>
        </div>

    </div>

    <div class="flex gap-3 mt-6">
        <button type="submit"
                class="bg-gray-900 text-white px-6 py-3 rounded-xl text-sm font-semibold hover:bg-gray-700"
                onclick="return confirm('Envoyer à tous les abonnés actifs ?')">
            📤 Envoyer la newsletter
        </button>
        <a href="{{ path('app_newsletter_abonnes') }}"
           class="border border-gray-300 text-gray-500 px-6 py-3 rounded-xl text-sm hover:bg-gray-100">
            Voir les abonnés
        </a>
    </div>

</form>

{% endblock %}