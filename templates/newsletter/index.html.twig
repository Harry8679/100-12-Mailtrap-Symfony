{% extends 'base.html.twig' %}

{% block title %}S'inscrire à la newsletter{% endblock %}

{% block body %}

<div class="text-center mb-10">
    <p class="text-5xl mb-4">📧</p>
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Notre Newsletter</h1>
    <p class="text-gray-400">Inscris-toi pour recevoir nos actualités directement dans ta boîte mail.</p>
</div>

<div class="bg-white border border-gray-200 rounded-2xl p-8 max-w-md mx-auto">

    {{ form_start(form) }}

        <div class="flex flex-col gap-5">

            <div>
                {{ form_label(form.prenom, null, {
                    'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}
                }) }}
                {{ form_widget(form.prenom) }}
            </div>

            <div>
                {{ form_label(form.email, null, {
                    'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}
                }) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
            </div>

            <button type="submit"
                    class="w-full bg-gray-900 text-white py-3 rounded-xl text-sm font-semibold hover:bg-gray-700">
                S'inscrire gratuitement →
            </button>

        </div>

    {{ form_end(form) }}

    <p class="text-xs text-gray-400 text-center mt-4">
        Pas de spam. Désabonnement en un clic.
    </p>

</div>

{% endblock %}